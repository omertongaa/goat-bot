# goat — Environment Variables
# Copy this file to .env and fill in your values

# ── AI / Orchestrator ──────────────────────────────────────────
# Anthropic API key — used by the CEO orchestrator agent for natural-language chat.
# Without this, CEO falls back to Claude CLI (local only) then keyword matching.
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Composio.dev API key — required for Apps page connections (Gmail, Slack,
# Calendar, Notion, GitHub, Stripe and 30+ others via OAuth).
# Get yours free at: https://app.composio.dev/developers
COMPOSIO_API_KEY=

# ── Core Lead Scraping ─────────────────────────────────────────
# Apify API token (required for Scout — Google Maps + B2B lead finder)
# Also used by the apify_web email finder provider
# Get yours free at https://console.apify.com/account/integrations
APIFY_TOKEN=

# Which Google Maps actor to use (optional, default: compass)
#   compass     → compass~google-maps-extractor (broad data, scrapeContacts=true)
#   lukaskrivka → lukaskrivka~google-maps-with-contact-details
#                 ($2.10/1000 place, richer email/phone/social extraction)
SCRAPER_ACTOR=compass

# ── Email Finder Providers (optional) ──────────────────────────
# Comma-separated waterfall: Scout will try providers in order and stop
# at the first hit per lead. Leave empty to disable enrichment.
# Available: emailapi, leadmagic, generect, apify_web
EMAIL_FINDER_PROVIDERS=

# EmailAPI.ai (Leadfwd) — ~$19-40/1000, Bearer auth, per-account domain
# Get key: https://app.emailapi.ai — Settings > Integrations > API
# Format: "{authKey}.{authSecret}"
EMAILAPI_KEY=
EMAILAPI_DOMAIN=

# LeadMagic — ~$7/1000, X-API-Key, 100 free trial credits (no card)
# Get key: https://leadmagic.io (free trial)
LEADMAGIC_API_KEY=

# Generect — ~$30-50/1000, Token auth, real-time scraping
# Get key: https://generect.com
GENERECT_API_KEY=

# ── Creative & Outreach (optional) ─────────────────────────────
# fal.ai API key (proposal covers, ad creatives)
# Get yours at https://fal.ai/dashboard/keys
FAL_KEY=

# Instantly.ai API key (for OutreachAgent email campaigns)
# Get yours at https://app.instantly.ai/app/settings/integrations
INSTANTLY_API_KEY=
