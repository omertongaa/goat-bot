{
  "name": "01 — Lead Form → CRM + Bildirim",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lead-form",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "a1111111-1111-1111-1111-111111111111",
      "name": "Lead Form Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [240, 300],
      "webhookId": "lead-form-webhook"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "fullName",
              "value": "={{ $json.body.fullName || $json.body.name }}",
              "type": "string"
            },
            {
              "id": "2",
              "name": "email",
              "value": "={{ $json.body.email }}",
              "type": "string"
            },
            {
              "id": "3",
              "name": "phone",
              "value": "={{ $json.body.phone || '' }}",
              "type": "string"
            },
            {
              "id": "4",
              "name": "message",
              "value": "={{ $json.body.message || '' }}",
              "type": "string"
            },
            {
              "id": "5",
              "name": "source",
              "value": "={{ $json.body.source || 'web' }}",
              "type": "string"
            },
            {
              "id": "6",
              "name": "createdAt",
              "value": "={{ $now.toISO() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a2222222-2222-2222-2222-222222222222",
      "name": "Normalize",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [460, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_GOOGLE_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "fullName": "={{ $json.fullName }}",
            "email": "={{ $json.email }}",
            "phone": "={{ $json.phone }}",
            "message": "={{ $json.message }}",
            "source": "={{ $json.source }}",
            "createdAt": "={{ $json.createdAt }}"
          }
        },
        "options": {}
      },
      "id": "a3333333-3333-3333-3333-333333333333",
      "name": "Google Sheet - Leads",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [680, 220],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_GOOGLE_SHEETS_CRED_ID",
          "name": "Google Sheets OAuth2"
        }
      }
    },
    {
      "parameters": {
        "sendTo": "REPLACE_WITH_OWNER_EMAIL@example.com",
        "subject": "Yeni lead: {{ $json.fullName }}",
        "emailType": "text",
        "message": "=Yeni lead geldi.\n\nİsim: {{ $json.fullName }}\nE-posta: {{ $json.email }}\nTelefon: {{ $json.phone }}\nKaynak: {{ $json.source }}\n\nMesaj:\n{{ $json.message }}\n\n— Form otomasyonu",
        "options": {}
      },
      "id": "a4444444-4444-4444-4444-444444444444",
      "name": "Gmail - Owner Notify",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [680, 380],
      "credentials": {
        "gmailOAuth2": {
          "id": "REPLACE_WITH_GMAIL_CRED_ID",
          "name": "Gmail OAuth2"
        }
      }
    }
  ],
  "connections": {
    "Lead Form Webhook": {
      "main": [[{ "node": "Normalize", "type": "main", "index": 0 }]]
    },
    "Normalize": {
      "main": [
        [
          { "node": "Google Sheet - Leads", "type": "main", "index": 0 },
          { "node": "Gmail - Owner Notify", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": false,
  "meta": {
    "note": "Webhook URL: {n8n_host}/webhook/lead-form — POST body: {fullName, email, phone, message, source}"
  },
  "tags": [{ "name": "doa-kit" }]
}
