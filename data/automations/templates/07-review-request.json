{
  "name": "07 — Satış Sonrası Review İsteği",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "cronExpression", "expression": "0 11 * * *" }]
        }
      },
      "id": "g1111111-1111-1111-1111-111111111111",
      "name": "Her Gün 11:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, customer_email, customer_name, product_name, sold_at\nFROM sales\nWHERE review_requested_at IS NULL\n  AND sold_at <= NOW() - INTERVAL '7 days'\n  AND sold_at >= NOW() - INTERVAL '30 days'\nLIMIT 100;",
        "options": {}
      },
      "id": "g2222222-2222-2222-2222-222222222222",
      "name": "7 Gün Önceki Satışlar",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [460, 300],
      "credentials": {
        "postgres": { "id": "REPLACE_WITH_POSTGRES_CRED_ID", "name": "Postgres" }
      }
    },
    {
      "parameters": {
        "sendTo": "={{ $json.customer_email }}",
        "subject": "={{ $json.customer_name }}, 30 saniyelik ricam var",
        "emailType": "html",
        "message": "=<p>Merhaba {{ $json.customer_name }},</p>\n<p>Geçen hafta {{ $json.product_name }} aldınız — nasıl gitti?</p>\n<p>Eğer memnun kaldıysanız Google'da 5 yıldız vermek bize çok yardımcı olur:</p>\n<p><a href=\"REPLACE_WITH_GOOGLE_REVIEW_LINK\" style=\"display:inline-block;background:#4285f4;color:white;padding:12px 24px;border-radius:6px;text-decoration:none\">⭐ Google'da değerlendir</a></p>\n<p>Eğer bir sıkıntı olduysa bu maile yanıt yazın, hemen hallederiz.</p>\n<p>Teşekkürler.</p>",
        "options": {}
      },
      "id": "g3333333-3333-3333-3333-333333333333",
      "name": "Review Maili",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [680, 220],
      "credentials": {
        "gmailOAuth2": { "id": "REPLACE_WITH_GMAIL_CRED_ID", "name": "Gmail OAuth2" }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE sales SET review_requested_at = NOW() WHERE id = '{{ $json.id }}';",
        "options": {}
      },
      "id": "g4444444-4444-4444-4444-444444444444",
      "name": "Mark Requested",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [680, 380],
      "credentials": {
        "postgres": { "id": "REPLACE_WITH_POSTGRES_CRED_ID", "name": "Postgres" }
      }
    }
  ],
  "connections": {
    "Her Gün 11:00": { "main": [[{ "node": "7 Gün Önceki Satışlar", "type": "main", "index": 0 }]] },
    "7 Gün Önceki Satışlar": {
      "main": [
        [
          { "node": "Review Maili", "type": "main", "index": 0 },
          { "node": "Mark Requested", "type": "main", "index": 0 }
        ]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "active": false,
  "meta": { "note": "sales tablosu: id, customer_email, customer_name, product_name, sold_at, review_requested_at" },
  "tags": [{ "name": "doa-kit" }]
}
